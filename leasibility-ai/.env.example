# Leasibility AI permanent deployment environment
# Copy these keys into the hosting provider's environment variable manager.

# Optional: most hosts inject this automatically.
PORT=3000

# Required: MySQL-compatible database URL, e.g. mysql://user:password@host:3306/database
DATABASE_URL=

# Required: long random string used to sign auth/session tokens
JWT_SECRET=

# Required by the app runtime OAuth integration
OAUTH_SERVER_URL=
VITE_APP_ID=

# Optional but recommended: owner/admin identity for production operations
OWNER_OPEN_ID=

# Required for billing features. Use live keys only after staging validation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional analytics placeholders. Leave blank unless analytics is configured.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional built-in AI/file-processing services used by hosted Manus-style integrations.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional object storage if uploads are moved out of inline/database flows.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
